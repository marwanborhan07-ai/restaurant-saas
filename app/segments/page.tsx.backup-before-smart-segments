"use client";

import { useEffect, useState } from "react";
import { AppShell } from "@/components/app-shell";
import { createClient } from "@/lib/supabase/client";

type Customer = {
  id: string;
  name: string;
  email: string | null;
  phone: string | null;
  total_orders: number;
  total_spent: number;
  last_order_at: string | null;
};

export default function SegmentsPage() {
  const [customers, setCustomers] = useState<Customer[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function loadCustomers() {
    const supabase = createClient();

    setLoading(true);
    setError("");

    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user) {
      setError("You are not logged in.");
      setLoading(false);
      return;
    }

    const { data: restaurant, error: restaurantError } =
      await supabase
        .from("restaurants")
        .select("id")
        .eq("owner_id", user.id)
        .single();

    if (restaurantError || !restaurant) {
      setError(
        restaurantError?.message || "Restaurant not found."
      );

      setLoading(false);
      return;
    }

    const { data, error: customersError } = await supabase
      .from("customers")
      .select("*")
      .eq("restaurant_id", restaurant.id)
      .order("total_spent", {
        ascending: false,
      });

    if (customersError) {
      setError(customersError.message);
    } else {
      setCustomers(data || []);
    }

    setLoading(false);
  }

  useEffect(() => {
    loadCustomers();
  }, []);


  // VIP Customers
  const vipCustomers = customers.filter(
    (customer) =>
      customer.total_spent >= 500 ||
      customer.total_orders >= 5
  );


  // Regular Customers
  const regularCustomers = customers.filter(
    (customer) =>
      !vipCustomers.some(
        (vip) => vip.id === customer.id
      ) &&
      customer.total_orders > 1
  );


  // New Customers
  const newCustomers = customers.filter(
    (customer) =>
      customer.total_orders <= 1 &&
      !vipCustomers.some(
        (vip) => vip.id === customer.id
      )
  );


  return (
    <AppShell title="Customer Segments">

      <div className="space-y-6">


        {/* Header */}

        <div>

          <h2 className="text-xl font-semibold text-gray-900">
            Customer Segments
          </h2>

          <p className="text-sm text-gray-500">
            Understand your customers and identify your most valuable ones.
          </p>

        </div>


        {/* Loading */}

        {loading && (

          <div className="rounded-2xl border bg-white p-6 text-gray-500">
            Loading customer segments...
          </div>

        )}


        {/* Error */}

        {error && (

          <div className="rounded-2xl border border-red-200 bg-red-50 p-6 text-red-600">
            Error: {error}
          </div>

        )}


        {!loading && !error && (

          <>

            {/* Segment Cards */}

            <div className="grid gap-5 md:grid-cols-3">


              {/* VIP */}

              <div className="rounded-2xl border bg-white p-6">

                <div className="flex items-center justify-between">

                  <div>

                    <p className="text-sm font-medium text-gray-500">
                      VIP Customers
                    </p>

                    <h3 className="mt-2 text-3xl font-bold text-purple-600">
                      {vipCustomers.length}
                    </h3>

                  </div>

                  <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-100 text-xl">
                    👑
                  </div>

                </div>

                <p className="mt-4 text-sm text-gray-500">
                  High-value customers with strong spending.
                </p>

              </div>



              {/* Regular */}

              <div className="rounded-2xl border bg-white p-6">

                <div className="flex items-center justify-between">

                  <div>

                    <p className="text-sm font-medium text-gray-500">
                      Regular Customers
                    </p>

                    <h3 className="mt-2 text-3xl font-bold text-blue-600">
                      {regularCustomers.length}
                    </h3>

                  </div>

                  <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-xl">
                    ⭐
                  </div>

                </div>

                <p className="mt-4 text-sm text-gray-500">
                  Returning customers who order regularly.
                </p>

              </div>



              {/* New */}

              <div className="rounded-2xl border bg-white p-6">

                <div className="flex items-center justify-between">

                  <div>

                    <p className="text-sm font-medium text-gray-500">
                      New Customers
                    </p>

                    <h3 className="mt-2 text-3xl font-bold text-green-600">
                      {newCustomers.length}
                    </h3>

                  </div>

                  <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-green-100 text-xl">
                    🆕
                  </div>

                </div>

                <p className="mt-4 text-sm text-gray-500">
                  Customers who are just getting started.
                </p>

              </div>


            </div>



            {/* Customer Table */}

            <div className="overflow-hidden rounded-2xl border bg-white">

              <div className="border-b p-6">

                <h3 className="text-lg font-semibold text-gray-900">
                  Customer Segmentation
                </h3>

                <p className="mt-1 text-sm text-gray-500">
                  Automatically grouped based on orders and spending.
                </p>

              </div>


              {customers.length === 0 ? (

                <div className="p-10 text-center">

                  <h3 className="text-lg font-semibold text-gray-900">
                    No customers yet
                  </h3>

                  <p className="mt-2 text-gray-500">
                    Add customers and orders to start building segments.
                  </p>

                </div>

              ) : (

                <table className="w-full text-left">

                  <thead className="border-b bg-gray-50 text-sm text-gray-500">

                    <tr>

                      <th className="px-6 py-4">
                        Customer
                      </th>

                      <th className="px-6 py-4">
                        Orders
                      </th>

                      <th className="px-6 py-4">
                        Total Spent
                      </th>

                      <th className="px-6 py-4">
                        Segment
                      </th>

                    </tr>

                  </thead>


                  <tbody>

                    {customers.map((customer) => {

                      let segment = "New";
                      let segmentStyle =
                        "bg-green-100 text-green-700";


                      if (
                        vipCustomers.some(
                          (vip) =>
                            vip.id === customer.id
                        )
                      ) {

                        segment = "VIP";

                        segmentStyle =
                          "bg-purple-100 text-purple-700";

                      } else if (
                        regularCustomers.some(
                          (regular) =>
                            regular.id === customer.id
                        )
                      ) {

                        segment = "Regular";

                        segmentStyle =
                          "bg-blue-100 text-blue-700";

                      }


                      return (

                        <tr
                          key={customer.id}
                          className="border-b last:border-0 hover:bg-gray-50"
                        >

                          <td className="px-6 py-4">

                            <div className="font-medium text-gray-900">
                              {customer.name}
                            </div>

                            <div className="text-sm text-gray-500">
                              {customer.email || "-"}
                            </div>

                          </td>


                          <td className="px-6 py-4">
                            {customer.total_orders || 0}
                          </td>


                          <td className="px-6 py-4 font-medium">

                            $
                            {(
                              customer.total_spent || 0
                            ).toFixed(2)}

                          </td>


                          <td className="px-6 py-4">

                            <span
                              className={`rounded-full px-3 py-1 text-xs font-medium ${segmentStyle}`}
                            >

                              {segment}

                            </span>

                          </td>

                        </tr>

                      );

                    })}

                  </tbody>

                </table>

              )}

            </div>


            {/* Segment Rules */}

            <div className="rounded-2xl border bg-white p-6">

              <h3 className="text-lg font-semibold text-gray-900">
                Segmentation Rules
              </h3>


              <div className="mt-5 grid gap-4 md:grid-cols-3">


                <div className="rounded-xl bg-purple-50 p-4">

                  <div className="font-semibold text-purple-700">
                    👑 VIP
                  </div>

                  <p className="mt-2 text-sm text-purple-600">
                    Spent $500+ or placed 5+ orders.
                  </p>

                </div>


                <div className="rounded-xl bg-blue-50 p-4">

                  <div className="font-semibold text-blue-700">
                    ⭐ Regular
                  </div>

                  <p className="mt-2 text-sm text-blue-600">
                    Returning customers with more than one order.
                  </p>

                </div>


                <div className="rounded-xl bg-green-50 p-4">

                  <div className="font-semibold text-green-700">
                    🆕 New
                  </div>

                  <p className="mt-2 text-sm text-green-600">
                    Customers with their first order.
                  </p>

                </div>


              </div>

            </div>

          </>

        )}

      </div>

    </AppShell>
  );
}
